{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Independent community Windows desktop distribution for the open-source DSH agent harness",
  "version": "0.1.0-rc.8.community.1",
  "private": true,
  "productName": "DSH Desktop Community",
  "author": "DSH Desktop Community Contributors",
  "homepage": "https://github.com/jiazhengfu912-lang/dsh-desktop-community",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiazhengfu912-lang/dsh-desktop-community.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main/index.mjs",
  "license": "MIT",
  "scripts": {
    "build": "tsdown && vite build",
    "build:main": "tsdown",
    "build:renderer": "vite build",
    "dev": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -b ../../tsconfig.client.json && tsc -b ../../tsconfig.host.json",
    "icon": "node build/generate-icon.cjs assets/app-icon.svg build/icon.ico",
    "prepare:windows-builder-cache": "node build/prepare-wincode-sign-cache.mjs",
    "smoke:packaged": "node build/smoke-packaged.mjs",
    "smoke:startup": "node build/smoke-startup.mjs",
    "smoke:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File build/smoke-installer.ps1",
    "release:metadata": "node build/create-release-metadata.mjs",
    "package": "pnpm run build && pnpm run icon && pnpm run prepare:windows-builder-cache && electron-builder --publish never && pnpm run smoke:packaged && pnpm run smoke:startup && pnpm run release:metadata"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-anonymous-user-id": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-compaction": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-output-retention": "workspace:^",
    "@deepseek-ai/dsh-sandbox": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-telemetry": "workspace:^",
    "@deepseek-ai/dsh-session-title-llm": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-spill": "workspace:^",
    "@deepseek-ai/dsh-subagent-in-process-driver": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-workflow": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-bash-local": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-ui-brand-community": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-pwsh-local": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker-electron": "workspace:^",
    "@deepseek-ai/dsh-host-frontend-static": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-document-viewer": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-web-app": "workspace:^",
    "dsh-better-sidebar": "0.14.0",
    "pnpm": "11.15.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.0.0",
    "dshmarket": "1.15.0",
    "electron": "43.4.1",
    "electron-builder": "25.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
