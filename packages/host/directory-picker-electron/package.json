{
  "name": "@deepseek-ai/dsh-host-directory-picker-electron",
  "description": "Electron-native directory-picker provider for DSH Desktop Community",
  "version": "0.1.0-rc.8.community.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiazhengfu912-lang/dsh-desktop-community.git",
    "directory": "packages/host/directory-picker-electron"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-host-directory-picker": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "electron": "^43.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "electron": "43.4.1"
  }
}
